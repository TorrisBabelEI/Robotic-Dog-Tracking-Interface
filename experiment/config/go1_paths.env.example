# Copy to .go1-paths.env at the repository root and set actual locations.
# Keep existing installed directory names; these variables are role-based aliases.
export GO1_POLICY_SOURCE='/path/to/go1_low_level'
export GO1_POLICY_REFERENCE='/path/to/run_go1_low_level'
export GO1_PI_POLICY_ROOT='/home/pi/installed_policy_directory'
